# MediVoice AI — Environment Variables
# Copy this file to .env and fill in your Sarvam API key

# Sarvam AI API Key (get from https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional overrides
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-m
MAX_IMAGE_SIZE_MB=10
